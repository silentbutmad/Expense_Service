// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  transaction_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_number String
  business_id        String   @db.Uuid
  party_id           String?  @db.Uuid

  transaction_type   TransactionType
  status             TransactionStatus @default(DRAFT)

  transaction_date   DateTime
  due_date           DateTime?

  subtotal_amount    Decimal @db.Decimal(15,2)
  total_gst_amount   Decimal @db.Decimal(15,2)
  total_amount       Decimal @db.Decimal(15,2)

  is_deleted         Boolean  @default(false)

  version            Int      @default(1)
  device_id          String?
  last_modified_at   DateTime @updatedAt

  created_at         DateTime @default(now())
  created_by_user_id String   @db.Uuid
  updated_by_user_id String?  @db.Uuid

  business Business @relation(fields: [business_id], references: [business_id])
  party    Party?   @relation(fields: [party_id], references: [party_id])
  payments Payment[]
  items    TransactionItem[]

  @@unique([business_id, transaction_number])
  @@index([business_id])
  @@index([party_id])
  @@index([business_id, transaction_date])
  @@index([business_id, status])
}

model Business {
  business_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  name          String
  gstNumber     String?
  address       String?

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  parties       Party[]
  items         Item[]
  transactions  Transaction[]
  categories    ExpenseCategory[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model User {
  user_id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name      String
  last_name       String
  email           String   @unique
  mobile_number   String   @unique
  language        String?
  password_hash   String
  salt            String?
  isverified      Boolean? @default(false)
  isactive        Boolean  @default(true)
  failed_attempts Int      @default(0)
  last_login      DateTime
  create_at       DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model ExpenseCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @db.Uuid
  name        String

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([businessId, name])
}

model Party {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  phone       String?
  type        PartyType

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

model Item {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  price       Decimal  @db.Decimal(12, 2)
  unit        String?
  gstRate     Decimal? @db.Decimal(5, 2)
  hsnCode     String?
  type        ItemType
  categoryId  String?  @db.Uuid

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  transactionItems TransactionItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

model TransactionItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @db.Uuid
  itemId        String   @db.Uuid
  quantity      Int
  price         Decimal  @db.Decimal(12, 2)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item          Item        @relation(fields: [itemId], references: [id])

  @@index([transactionId])
}

model Payment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId   String   @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  mode            PaymentMode
  reference       String?
  paymentDate     DateTime

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([transactionId])
}

model Reminder {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @db.Uuid
  channel       ReminderChannel
  scheduledDate DateTime
  status        ReminderStatus @default(PENDING)
  lastSentAt    DateTime?

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model SupportTicket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  subject   String
  message   String
  status    TicketStatus @default(OPEN)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PartyType {
  CUSTOMER
  VENDOR
}

enum PaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum ReminderChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum TicketStatus {
  OPEN
  CLOSED
  IN_PROGRESS
}

enum ItemType {
  PRODUCT
  SERVICE
}
