// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  transaction_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_number String
  business_id        String   @db.Uuid
  party_id           String?  @db.Uuid

  transaction_type   TransactionType

  transaction_date   DateTime
  due_date           DateTime?

  subtotal_amount    Decimal @db.Decimal(15,2)
  total_gst_amount   Decimal @db.Decimal(15,2)
  total_amount       Decimal @db.Decimal(15,2)

  is_deleted         Boolean  @default(false)

  device_id          String?
  last_modified_at   DateTime @updatedAt

  created_at         DateTime @default(now())
  created_by_user_id String   @db.Uuid
  updated_by_user_id String?  @db.Uuid


  @@unique([business_id, transaction_number])
  @@index([business_id])
  @@index([party_id])
  @@index([business_id, transaction_date])
}

model Business {
  business_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  business_name String
  gst_number     String?
  address       String?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([user_id])
}



model Expense_Category {
  category_id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String   @db.Uuid
  category_name        String

  createdAt   DateTime @default(now())

  @@unique([business_id, category_name])
  @@index([business_id])
}

model Party {
  party_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id   String   @db.Uuid
  name          String
  phone         String?
  party_type    PartyType


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([business_id])
}

model Item {
  item_id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String   @db.Uuid
  name        String
  price       Decimal  @db.Decimal(12, 2)
  unit        String?
  gst_rate     Decimal? @db.Decimal(5, 2)
  hsn_code     String?
  item_type    ItemType
  category_id  String?  @db.Uuid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([business_id])
}

model Transaction_item {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id String   @db.Uuid
  item_id        String   @db.Uuid
  quantity      Int
  price         Decimal  @db.Decimal(12, 2)


  @@index([transaction_id])
  @@index([item_id])
}



model Reminder {
  reminder_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id String   @db.Uuid
  channel       ReminderChannel
  scheduled_date DateTime
  status        ReminderStatus @default(PENDING)
  last_sent_at    DateTime?

  
  @@index([transaction_id])
}



enum TransactionType {
  SALE
  EXPENSE
  PURCHASE
}

enum PartyType {
  CUSTOMER
  sUPPLIER
}


enum ReminderChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}


enum ItemType {
  PRODUCT
  EXPENSE
}
